# ---- Frontend (Vite) ----
# App Supabase: criar projeto em supabase.com e copiar URL + anon key
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
# Chave pública VAPID para Web Push (M9). Gerar com: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
# App só para 2 pessoas — email de cada um (define a identidade; recusa outros)
VITE_JOAO_EMAIL=
VITE_JOANA_EMAIL=

# ---- Edge Functions / secrets do Supabase (NUNCA no frontend) ----
# Definir com: supabase secrets set NOME=valor
# ANTHROPIC_API_KEY=sk-ant-...
# EB_APP_ID=...
# EB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
